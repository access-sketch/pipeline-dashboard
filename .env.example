# Required
GHL_TOKEN=            # GHL private integration token (sub-account)
GHL_LOCATION_ID=      # GHL sub-account (location) ID
META_ACCESS_TOKEN=    # Meta System User token with ads_read
META_AD_ACCOUNT_ID=   # Ad account ID, with or without "act_"
DASHBOARD_PASSWORD=   # Password to open the dashboard (any username)
CRON_SECRET=          # Any long random text; Vercel uses it for the daily sync

# Added automatically when Supabase is connected in Vercel
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Optional
DASHBOARD_TITLE=          # Name shown at the top, e.g. your business name
EXCLUDED_EMAILS=          # Comma-separated emails that are never counted as leads
EXCLUDED_EMAIL_DOMAINS=   # Comma-separated domains, e.g. yourcompany.com
SLACK_WEBHOOK_URL=        # Get a Slack message if the daily sync fails
DASHBOARD_TIMEZONE=       # Only used before the first sync; afterwards the ad account time zone is used
